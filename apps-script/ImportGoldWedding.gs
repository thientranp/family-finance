// 4 lô vàng có giá mua rõ ràng (tổng 60.415.000đ) — người dùng xác nhận 07/11/2026 các khoản này
// CHƯA từng được ghi vào sổ giao dịch chính (sheet `gold` nằm ngoài phạm vi import `finance`), nên
// ghi thêm 1 giao dịch "Mua vàng" (trừ ví) cho mỗi lô, idempotency key riêng theo source_ref của lô.
function impGoldWeddingPlan_(m, commit) {
  var wid = null;
  readAll_('Wallets').forEach(function (w) { if (impKey_(w.name) === impKey_(FF_GOLD_BUY_WALLET)) wid = w.wallet_id; });
  if (!wid) throw ffErr_('IMPORT', 'Chưa có ví "' + FF_GOLD_BUY_WALLET + '". Tạo ví này trước (hoặc kiểm tra đúng tên).');

  var goldExisting = {};
  readAll_('GoldLots').forEach(function (g) { if (g.source_ref) goldExisting[g.source_ref] = g.lot_id; });
  var goldCreated = 0, goldSkipped = 0, goldQty = 0, goldValue = 0;
  FF_GOLD_SEED.forEach(function (g) { if (!goldExisting[g.source_ref]) { goldQty += g.quantity; goldValue += g.purchase_value; } });

  var weddingExisting = {};
  readAll_('WeddingGifts').forEach(function (g) { if (g.source_ref) weddingExisting[g.source_ref] = g.gift_id; });
  var wedCreated = 0, wedSkipped = 0, wedCash = 0, wedGold = 0, wedUsd = 0;
  FF_WEDDING_SEED.forEach(function (w) {
    if (weddingExisting[w.source_ref]) { wedSkipped++; return; }
    wedCreated++; wedCash += w.cash_amount; wedGold += w.gold_amount; wedUsd += w.usd_amount;
  });

  var lines = [];
  lines.push('VÀNG: nguồn 9 lô / 26 chỉ / 60.415.000đ (4 lô có giá, 5 lô giá 0 vì được tặng/không rõ giá)');
  FF_GOLD_SEED.forEach(function (g) {
    var already = !!goldExisting[g.source_ref];
    lines.push('  ' + (already ? '[đã có, bỏ qua]' : '[sẽ nhập]') + ' ' + g.source_ref + ' · ' + g.brand + ' · ' + g.quantity + ' chỉ · ' + vnd_(g.purchase_value));
  });
  lines.push('SỔ CƯỚI: nguồn 487 dòng / ' + vnd_(213279111) + ' / 12.2 chỉ / 300 USD');
  lines.push('  sẽ nhập ' + wedCreated + ' dòng (' + vnd_(wedCash) + ' / ' + wedGold + ' chỉ / ' + wedUsd + ' USD), bỏ qua (đã có) ' + wedSkipped + ' dòng');

  var goldBuyPlans = [], goldBuyErrors = [];
  if (commit) {
    // Gọi thẳng bản lõi không tự khoá (importGoldWedding() ở dưới đã khoá 1 lần ở ngoài cùng rồi).
    var impRes = importGoldLotsCore_(m, { rows: FF_GOLD_SEED });
    goldCreated = impRes.created.length; goldSkipped = impRes.skipped.length;
    var wedRes = importWeddingGiftsCore_(m, { rows: FF_WEDDING_SEED });
    wedCreated = wedRes.created.length; wedSkipped = wedRes.skipped.length;

    // Ghi giao dịch "Mua vàng" cho các lô vừa nhập có giá > 0 (chạy lại an toàn: idempotency key
    // riêng theo source_ref, không phụ thuộc lot_id vừa tạo).
    var st2 = buildState_();
    var lotBySource = {};
    readAll_('GoldLots').forEach(function (g) { if (g.source_ref) lotBySource[g.source_ref] = g; });
    FF_GOLD_SEED.forEach(function (g) {
      if (!g.purchase_value) return;
      var lot = lotBySource[g.source_ref];
      if (!lot) return;
      var key = 'imp:gold:buy:' + g.source_ref;
      try {
        var out = planPost_(st2, m.member_id, { kind: 'gold_purchase', date: g.purchase_date, amount: g.purchase_value, wallet_id: wid, lot_id: lot.lot_id, key: key, note: 'Nhập lịch sử từ Excel' });
        if (!out.duplicate) goldBuyPlans.push(out.plan);
      } catch (e) {
        if (e && e.ffCode) goldBuyErrors.push(g.source_ref + ': ' + e.message); else throw e;
      }
    });
    if (goldBuyPlans.length) commitPlans_(goldBuyPlans, 100);
    lines.push('Đã ghi: ' + goldCreated + ' lô vàng mới, ' + goldBuyPlans.length + ' giao dịch mua vàng, ' + wedCreated + ' dòng sổ cưới.');
    if (goldBuyErrors.length) { lines.push('LỖI khi ghi giao dịch mua vàng:'); goldBuyErrors.forEach(function (e) { lines.push('  ' + e); }); }
    audit_('import:gold_wedding', 'import', { gold: goldCreated, gold_buy_txn: goldBuyPlans.length, wedding: wedCreated });
  }
  return lines.join('\n');
}

function importGoldWeddingDryRun() {
  var m = requireMember_();
  var text = 'DRY RUN vàng + sổ cưới (Appsheet_Finance.xlsx) ' + nowIso_() + '\n' + impGoldWeddingPlan_(m, false);
  Logger.log(text); return text;
}

function importGoldWedding() {
  var m = requireMember_();
  var text = withLock_(function () { return 'IMPORT vàng + sổ cưới (Appsheet_Finance.xlsx) ' + nowIso_() + '\n' + impGoldWeddingPlan_(m, true); });
  Logger.log(text); return text;
}
