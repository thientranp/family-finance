# Copy this file to .env.local for local development. Never commit real values.

# Public values (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only values (never expose to the browser, never prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Backup encryption (server-only, used by the scheduled backup job)
BACKUP_ENCRYPTION_KEY=your-backup-passphrase

# Email fallback for reminders (server-only, optional until phase 8)
RESEND_API_KEY=your-resend-api-key
